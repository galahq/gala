DATABASE_URL=postgres://gala:alpine@localhost:5432/gala
REDIS_URL=redis://localhost:6379/0
BASE_URL=http://localhost:3000
APP_HOST_PORT=3000
WEBPACK_HOST_PORT=3035
REDIS_HOST_PORT=6379
RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
WEB_CONCURRENCY=2
SIDEKIQ_CONCURRENCY=1
RUBY_YJIT_ENABLE=1
COMPOSE_PROJECT_NAME=gala
MAPBOX_ACCESS_TOKEN=CHANGEME

# For a second local stack, change COMPOSE_PROJECT_NAME and the host ports above.
# If you also run Rails/Redis on the host, update DATABASE_URL / REDIS_URL to match.
