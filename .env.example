# Copy to .env for local direnv-loaded settings. Do not commit real values.

# Cloudflare provider credentials used by local SST commands.
CF_ACCOUNT_ID=
CF_ACCESS_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DEFAULT_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# SST/deploy defaults for local infra work.
AWS_PROFILE=gala
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2
SST_STAGE=production
GALA_DOMAIN_NAME=learngala.dev
GALA_ENABLE_CUSTOM_DOMAIN=true
GALA_CLOUDFLARE_PROXY=false
