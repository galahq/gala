# syntax = docker/dockerfile:1

ARG RUBY_VERSION=4.0.3
ARG NODE_VERSION=24.15.0
ARG PNPM_VERSION=11.1.0
ARG BUNDLER_VERSION=2.4.19
ARG DEBIAN_SUITE=bookworm

FROM node:${NODE_VERSION}-${DEBIAN_SUITE}-slim AS node

FROM ruby:${RUBY_VERSION}-slim-${DEBIAN_SUITE} AS runtime-base

ARG BUNDLER_VERSION=2.4.19
ARG DEBIAN_SUITE=bookworm

WORKDIR /gala

ENV BUNDLE_PATH="/usr/local/bundle" \
    BUNDLE_WITHOUT="development:test" \
    MALLOC_CONF="dirty_decay_ms:1000,narenas:2,background_thread:true,stats_print:false" \
    PATH="/gala/bin:/usr/local/bundle/bin:/usr/local/bin:${PATH}" \
    RAILS_ENV="production" \
    RAILS_LOG_TO_STDOUT="true" \
    RAILS_SERVE_STATIC_FILES="true"

# Runtime packages only. Keep PDF/image/font support until route evidence proves it unused.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    fontconfig \
    gnupg \
    libjemalloc2 \
    libvips \
    procps \
    wkhtmltopdf \
    xfonts-75dpi \
    xfonts-base \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt ${DEBIAN_SUITE}-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-17 \
    && echo "gem: --no-document" > /etc/gemrc \
    && gem install bundler:${BUNDLER_VERSION} \
    && pg_restore --version \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives /root/.gem

FROM runtime-base AS build

ARG PNPM_VERSION=11.1.0
ARG rails_env=production

ENV NODE_ENV="production" \
    NODE_PATH="/usr/local/lib/node_modules" \
    RAILS_ENV="${rails_env}"

# Build-only Node and pnpm tooling. Nothing from this block is copied into final runtime.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/bin/npm /usr/local/bin/npm
COPY --from=node /usr/local/bin/npx /usr/local/bin/npx
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    git \
    libffi-dev \
    libjemalloc-dev \
    libpq-dev \
    libreadline-dev \
    libssl-dev \
    libyaml-dev \
    make \
    pkg-config \
    python3 \
    zlib1g-dev \
    && ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -sf ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack \
    && node --version \
    && npm --version \
    && corepack enable \
    && corepack prepare pnpm@${PNPM_VERSION} --activate \
    && pnpm --version \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives /root/.npm

COPY .ruby-version Gemfile Gemfile.lock package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN bundle config set deployment 'true' \
    && bundle config set without 'development test' \
    && bundle config set build.sassc --disable-march-tune-native \
    && bundle install --jobs 20 --retry 2 \
    && pnpm install --frozen-lockfile --prod=false \
    && rm -rf ~/.bundle/ /root/.cache /root/.local/share/pnpm /root/.npm \
    && rm -rf ${BUNDLE_PATH}/ruby/*/cache ${BUNDLE_PATH}/ruby/*/bundler/gems/*/.git \
    && gem cleanup all \
    && bundle exec bootsnap precompile --gemfile

COPY . ./

RUN if [ "$RAILS_ENV" != "development" ]; then \
      export DATABASE_URL=postgresql://placeholder/placeholder; \
      SECRET_KEY_BASE_DUMMY=1 SECRET_KEY_BASE=build-placeholder bundle exec bootsnap precompile app/ lib/; \
      SECRET_KEY_BASE_DUMMY=1 SECRET_KEY_BASE=build-placeholder bundle exec rails assets:precompile; \
    fi \
    && chmod +x entrypoint.sh \
    && rm -rf node_modules .git spec test coverage tmp/cache tmp/shakapacker tmp/webpacker \
    && rm -rf /root/.cache /root/.local/share/pnpm /root/.npm ~/.bundle \
    && rm -rf ${BUNDLE_PATH}/ruby/*/cache ${BUNDLE_PATH}/ruby/*/bundler/gems/*/.git

FROM runtime-base AS production

ENV NODE_ENV="production" \
    RAILS_ENV="production"

COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build /gala /gala

RUN chmod +x entrypoint.sh \
    && groupadd --system --gid 1000 rails \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash rails \
    && mkdir -p tmp/pids tmp/cache log \
    && chown -R rails:rails /gala /usr/local/bundle

USER rails
ENTRYPOINT ["./entrypoint.sh"]
EXPOSE 3000
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]
