#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "shellwords"
require "socket"
require "tmpdir"

APP_ROOT = File.expand_path("..", __dir__)
WORKSPACE_NAME = File.basename(APP_ROOT)
DEFAULT_SESSION_NAME = WORKSPACE_NAME.gsub(/[^A-Za-z0-9_.-]/, "_")
SERVER_NAME = (ENV["GALA_DEV_TMUX_SERVER"].to_s.strip.empty? ? DEFAULT_SESSION_NAME : ENV["GALA_DEV_TMUX_SERVER"].to_s.strip)
DOCKER_WINDOW_NAME = "docker"
CHEATSHEET_WINDOW_NAME = "cheatsheet"

def cheatsheet_enabled?
  value = ENV.fetch("GALA_DEV_CHEATSHEET", "1").to_s.strip
  %w[1 true yes y on].include?(value.downcase)
end

def usage
  <<~USAGE
    Usage:
      bin/dev                  Open the interactive tmux session menu
      bin/dev attach [SESSION] Attach to an existing session
      bin/dev new [SESSION]    Create or attach to a session
      bin/dev stack [SESSION]  Open the Docker Compose stack window
      bin/dev list             List sessions on the project tmux server
      bin/dev help             Show this help

    Defaults:
      tmux server: #{SERVER_NAME}
      session:     #{DEFAULT_SESSION_NAME}

    Environment:
      GALA_DEV_TMUX_SERVER can override the dedicated tmux server name.
      GALA_DEV_CHEATSHEET controls cheatsheet behavior (set to 0 to disable; defaults to 1).
  USAGE
end

def cheatsheet
  <<~CHEATSHEET
    === bin/dev Cheatsheet ===

    Usage:
      bin/dev                  Open interactive tmux menu
      bin/dev attach [SESSION] Attach to an existing session
      bin/dev new [SESSION]    Create or attach to a session
      bin/dev stack [SESSION]  Open the Docker Compose stack window
      bin/dev list             List sessions on the project tmux server
      bin/dev help             Show this help

    Defaults:
      tmux server: #{SERVER_NAME}
      session:     #{DEFAULT_SESSION_NAME}

    Environment:
      GALA_DEV_TMUX_SERVER can override the dedicated tmux server name.
      GALA_DEV_CHEATSHEET controls cheatsheet behavior (set to 0 to disable; defaults to 1).

    Sessions are created on a dedicated tmux server:
      tmux -L #{SERVER_NAME}

    Stack helper env vars:
      GALA_DEV_ROOT
      GALA_DEV_SESSION
      GALA_DEV_TMUX_SERVER
      COMPOSE_PROJECT_NAME
      APP_HOST_PORT
      ANYCABLE_HOST_PORT
      ANYCABLE_WEBSOCKET_URL
      REDIS_HOST_PORT
      BASE_URL
  CHEATSHEET
end

def print_cheatsheet
  puts(cheatsheet)
end

def print_cheatsheet_if_enabled
  return unless cheatsheet_enabled?

  print_cheatsheet
end

def cheatsheet_path
  File.join(Dir.tmpdir, "#{WORKSPACE_NAME}-dev-cheatsheet.txt")
end

def editor_command(file)
  editor = ENV["EDITOR"].to_s.strip
  parts = Shellwords.split(editor)
  parts = ["nvim"] if parts.empty?

  (parts + [file]).map { |token| Shellwords.shellescape(token) }.join(" ")
end

def open_cheatsheet_window(session)
  target = "#{session}:#{CHEATSHEET_WINDOW_NAME}"

  File.write(cheatsheet_path, cheatsheet)

  if window_exists?(session, CHEATSHEET_WINDOW_NAME)
    tmux!("kill-window", "-t", target)
  end

  stdout, = capture_tmux(
    "new-window",
    "-d",
    "-P",
    "-F",
    '#{window_id}',
    "-t",
    session,
    "-n",
    CHEATSHEET_WINDOW_NAME,
    "-c",
    APP_ROOT
  )
  window_id = stdout.strip
  shell = ENV["SHELL"].to_s.strip.empty? ? "/bin/bash" : ENV["SHELL"].to_s.strip
  command = ["cd #{APP_ROOT.shellescape}", editor_command(cheatsheet_path), "exec #{Shellwords.shellescape(shell)}"].join("; ")

  tmux!("send-keys", "-t", window_id, command, "C-m")

  tmux!("set-window-option", "-t", window_id, "automatic-rename", "off")
  tmux!("rename-window", "-t", window_id, CHEATSHEET_WINDOW_NAME)
rescue Errno::ENOENT
  warn("Unable to open cheatsheet window for tmux session #{session}.")
end

def open_cheatsheet_for_session(session)
  return unless cheatsheet_enabled?

  open_cheatsheet_window(session)
rescue StandardError
  # Do not block dev workflow if cheatsheet editor launch fails.
  warn("Could not open cheatsheet window; continuing with dev session.")
end

def abort_with(message)
  warn(message)
  exit(1)
end

def tmux_available!
  return if system("tmux", "-V", out: File::NULL, err: File::NULL)

  abort_with("tmux is required but was not found on PATH.")
end

def tmux(*args, env: {}, **options)
  if env.empty?
    system("tmux", "-L", SERVER_NAME, *args, **options)
  else
    system(env, "tmux", "-L", SERVER_NAME, *args, **options)
  end
end

def tmux!(*args, env: {}, **options)
  tmux(*args, env: env, **options) || abort_with("tmux command failed: tmux -L #{SERVER_NAME} #{args.shelljoin}")
end

def capture_tmux(*args)
  Open3.capture3("tmux", "-L", SERVER_NAME, *args)
end

def sanitize_session_name(name)
  value = name.to_s.strip
  value = DEFAULT_SESSION_NAME if value.empty?
  value.gsub(/[^A-Za-z0-9_.-]/, "_")
end

def sanitize_compose_project_name(name)
  value = name.downcase.gsub(/[^a-z0-9_-]/, "_").gsub(/\A[^a-z0-9]+/, "")
  value.empty? ? DEFAULT_SESSION_NAME.downcase.gsub(/[^a-z0-9_-]/, "_") : value
end

def compose_project_name(session)
  base = sanitize_compose_project_name(DEFAULT_SESSION_NAME)
  session_project = sanitize_compose_project_name(session)

  session_project == base ? base : sanitize_compose_project_name("#{base}_#{session_project}")
end

def prompt(message, default: nil)
  print(default ? "#{message} [#{default}]: " : "#{message}: ")
  input = STDIN.gets
  return default if input.nil?

  value = input.strip
  value.empty? ? default : value
end

def tty?
  STDIN.tty? && STDOUT.tty?
end

def list_sessions
  stdout, = capture_tmux("list-sessions", "-F", '#{session_name}')
  stdout.lines.map(&:strip).reject(&:empty?)
rescue Errno::ENOENT
  []
rescue Errno::EPERM
  []
end

def session_exists?(session)
  tmux("has-session", "-t", session, out: File::NULL, err: File::NULL)
end

def window_exists?(session, window_name)
  stdout, = capture_tmux("list-windows", "-t", session, "-F", '#{window_name}')
  stdout.lines.map(&:strip).include?(window_name)
end

def read_tmux_env(session, key)
  stdout, _stderr, status = capture_tmux("show-environment", "-t", session, key)
  return nil unless status.success?

  line = stdout.strip
  return nil if line.empty? || line.start_with?("-")

  line.split("=", 2).last
end

def lsof_available?
  return @lsof_available unless @lsof_available.nil?

  @lsof_available = system("lsof", "-v", out: File::NULL, err: File::NULL)
end

def reserved_port?(port)
  if lsof_available?
    return system("lsof", "-nP", "-iTCP:#{port}", "-sTCP:LISTEN", out: File::NULL, err: File::NULL)
  end

  server = TCPServer.new("0.0.0.0", port)
  server.close
  false
rescue Errno::EADDRINUSE, Errno::EACCES, SocketError
  true
rescue Errno::EPERM
  abort_with("Cannot inspect host port availability. Install lsof or run outside a restricted sandbox.")
end

def next_free_port(preferred, selected)
  port = Integer(preferred)

  loop do
    abort_with("No free port found at or above #{preferred}.") if port > 65_535

    return port unless selected.include?(port) || reserved_port?(port)

    port += 1
  end
end

def allocated_ports_for(session)
  existing = {
    app: read_tmux_env(session, "APP_HOST_PORT"),
    anycable: read_tmux_env(session, "ANYCABLE_HOST_PORT"),
    valkey: read_tmux_env(session, "REDIS_HOST_PORT")
  }

  if existing.values.all? { |value| value.to_s.match?(/\A\d+\z/) }
    return existing.transform_values(&:to_i)
  end

  selected = []
  app = next_free_port(ENV.fetch("APP_HOST_PORT", "3000"), selected)
  selected << app
  anycable = next_free_port(ENV.fetch("ANYCABLE_HOST_PORT", "3002"), selected)
  selected << anycable
  valkey = next_free_port(ENV.fetch("REDIS_HOST_PORT", "6379"), selected)

  { app: app, anycable: anycable, valkey: valkey }
end

def session_env(session)
  ports = allocated_ports_for(session)

  {
    "GALA_DEV_ROOT" => APP_ROOT,
    "GALA_DEV_SESSION" => session,
    "GALA_DEV_TMUX_SERVER" => SERVER_NAME,
    "COMPOSE_PROJECT_NAME" => compose_project_name(session),
    "APP_HOST_PORT" => ports.fetch(:app).to_s,
    "ANYCABLE_HOST_PORT" => ports.fetch(:anycable).to_s,
    "ANYCABLE_WEBSOCKET_URL" => "ws://localhost:#{ports.fetch(:anycable)}/cable",
    "ANYCABLE_ALLOWED_ORIGINS" => "localhost:#{ports.fetch(:app)},127.0.0.1:#{ports.fetch(:app)}",
    "REDIS_HOST_PORT" => ports.fetch(:valkey).to_s,
    "BASE_URL" => "http://localhost:#{ports.fetch(:app)}"
  }
end

def set_tmux_env(session, env)
  env.each do |key, value|
    tmux!("set-environment", "-g", key, value)
    tmux!("set-environment", "-t", session, key, value) if session_exists?(session)
  end
end

def create_session(session)
  env = session_env(session)

  unless session_exists?(session)
    tmux!("new-session", "-d", "-s", session, "-c", APP_ROOT, env: env)
  end

  set_tmux_env(session, env)
  env
end

def inside_dedicated_tmux?
  return false if ENV["TMUX"].to_s.empty?

  socket_path = ENV["TMUX"].split(",", 2).first
  File.basename(socket_path) == SERVER_NAME
end

def attach_or_switch(session, window_name: nil)
  target = window_name ? "#{session}:#{window_name}" : session

  if inside_dedicated_tmux?
    tmux!("switch-client", "-t", target)
    return
  end

  unless tty?
    puts("Session ready on tmux server #{SERVER_NAME}: #{target}")
    puts("Attach with: tmux -L #{SERVER_NAME.shellescape} attach-session -t #{target.shellescape}")
    return
  end

  env = ENV.to_h
  env.delete("TMUX")
  exec(env, "tmux", "-L", SERVER_NAME, "attach-session", "-t", target)
end

def choose_existing_session(sessions)
  return sessions.first if sessions.length == 1

  puts
  sessions.each.with_index(1) { |session, index| puts("  #{index}. #{session}") }
  selection = prompt("Attach to session", default: "1").to_i
  sessions.fetch(selection - 1) { abort_with("Invalid session selection.") }
end

def interactive
  abort_with("Interactive mode requires a terminal. Run `bin/dev help` for commands.") unless tty?

  sessions = list_sessions

  puts("Gala development tmux server: #{SERVER_NAME}")
  if sessions.empty?
    puts("No sessions exist yet.")
  else
    puts("Existing sessions: #{sessions.join(", ")}")
  end

  options = []
  options << ["Attach to an existing session", :attach] unless sessions.empty?
  options << ["Create a new session", :new]
  options << ["Open Docker stack window", :stack]
  options << ["Quit", :quit]

  puts
  options.each.with_index(1) { |(label, _action), index| puts("  #{index}. #{label}") }
  selection = prompt("Selection", default: "1").to_i
  action = options.fetch(selection - 1) { abort_with("Invalid selection.") }.last

  case action
  when :attach
    session = choose_existing_session(sessions)
    create_session(session)
    open_cheatsheet_for_session(session)
    print_cheatsheet_if_enabled
    attach_or_switch(session)
  when :new
    session = sanitize_session_name(prompt("Session name", default: DEFAULT_SESSION_NAME))
    create_session(session)
    open_cheatsheet_for_session(session)
    print_cheatsheet_if_enabled
    attach_or_switch(session)
  when :stack
    session = sanitize_session_name(prompt("Session name", default: ENV["GALA_DEV_SESSION"] || DEFAULT_SESSION_NAME))
    open_stack(session)
  when :quit
    exit(0)
  end
end

def shell_export(env)
  env.map { |key, value| "export #{key}=#{value.shellescape}" }.join("; ")
end

def docker_window_command(env)
  [
    "cd #{APP_ROOT.shellescape}",
    "tmux set-window-option -t \"$TMUX_PANE\" automatic-rename off >/dev/null 2>&1 || true",
    "tmux rename-window -t \"$TMUX_PANE\" #{DOCKER_WINDOW_NAME.shellescape} >/dev/null 2>&1 || true",
    shell_export(env),
    "bin/dev run-stack #{env.fetch("GALA_DEV_SESSION").shellescape}"
  ].join("; ")
end

def pid_alive?(pid)
  Process.kill(0, pid)
  true
rescue Errno::ESRCH
  false
rescue Errno::EPERM
  true
end

def ps_process_group_pids(pgid)
  stdout, = Open3.capture3("ps", "-axo", "pid=,pgid=")
  stdout.lines.filter_map do |line|
    pid, group = line.split.map(&:to_i)
    pid if group == pgid
  end
rescue Errno::ENOENT, Errno::EPERM
  []
end

def process_group_pids(pgid)
  stdout, _stderr, status = Open3.capture3("pgrep", "-g", pgid.to_s)
  pids = stdout.lines.map { |line| line.strip.to_i }.select(&:positive?)
  return pids.uniq if status.success? || pids.any?

  pids = ps_process_group_pids(pgid)
  return pids.uniq if pids.any?

  pid_alive?(pgid) ? [pgid] : []
rescue Errno::ENOENT
  pids = ps_process_group_pids(pgid)
  return pids.uniq if pids.any?

  pid_alive?(pgid) ? [pgid] : []
end

def pid_table(pids)
  return "" if pids.empty?

  stdout, = Open3.capture3("ps", "-o", "pid=,ppid=,pgid=,command=", "-p", pids.join(","))
  stdout
rescue Errno::ENOENT
  ""
rescue Errno::EPERM
  ""
end

def print_process_state(prefix, pids)
  if pids.empty?
    puts("All managed processes are down.")
    return
  end

  puts("#{prefix}: #{pids.join(", ")}")
  table = pid_table(pids)
  puts(table) unless table.empty?
end

def signal_process_group(pgid, signal)
  Process.kill(signal, -pgid)
rescue Errno::ESRCH
  nil
end

def reap_child(pid)
  Process.waitpid2(pid, Process::WNOHANG)
rescue Errno::ECHILD
  nil
end

def wait_for_process_group_down(pgid, child_pid, timeout_seconds)
  deadline = Time.now + timeout_seconds
  remaining = process_group_pids(pgid)

  until remaining.empty? || Time.now >= deadline
    reap_child(child_pid)
    sleep(0.25)
    remaining = process_group_pids(pgid)
  end

  remaining
end

def clear_stack_pid(session)
  tmux("set-environment", "-t", session, "-u", "GALA_DEV_STACK_PGID", out: File::NULL, err: File::NULL)
end

def print_restart_hint(session)
  puts("Invoke `bin/dev stack #{session}` to begin again.")
end

def exit_code_for(status)
  return 1 unless status
  return status.exitstatus if status.exited?
  return 128 + status.termsig if status.signaled?

  1
end

def shutdown_stack_process_group(session, pgid, child_pid, signal, exit_code)
  puts
  puts("Received SIG#{signal}; forwarding to managed process group #{pgid}.")
  signal_process_group(pgid, signal)

  remaining = wait_for_process_group_down(pgid, child_pid, 8)
  if remaining.empty?
    print_process_state("Still running PIDs", remaining)
    clear_stack_pid(session)
    print_restart_hint(session)
    return exit_code
  end

  print_process_state("Still running PIDs after 8 seconds; forcing shutdown", remaining)
  signal_process_group(pgid, "KILL")
  remaining = wait_for_process_group_down(pgid, child_pid, 2)
  print_process_state("Still running PIDs after SIGKILL", remaining)
  clear_stack_pid(session)
  print_restart_hint(session)
  1
end

def finalize_stack_process_group(session, pgid, child_pid, status)
  exit_code = exit_code_for(status)
  remaining = wait_for_process_group_down(pgid, child_pid, 0)

  unless remaining.empty?
    print_process_state("Docker Compose exited, but managed child PIDs are still running", remaining)
    signal_process_group(pgid, "TERM")
    remaining = wait_for_process_group_down(pgid, child_pid, 8)
    unless remaining.empty?
      print_process_state("Still running PIDs after 8 seconds; forcing shutdown", remaining)
      signal_process_group(pgid, "KILL")
      remaining = wait_for_process_group_down(pgid, child_pid, 2)
      exit_code = 1
    end
  end

  print_process_state("Still running PIDs", remaining)
  clear_stack_pid(session)
  print_restart_hint(session)
  exit_code
end

def run_stack(session)
  env = session_env(session)
  ENV.update(env)
  set_tmux_env(session, env) if session_exists?(session)

  puts("Starting Gala Docker stack on #{env.fetch("BASE_URL")}")
  puts("Rails: #{env.fetch("APP_HOST_PORT")}  AnyCable: #{env.fetch("ANYCABLE_HOST_PORT")}  Vite: build:js:watch  Valkey: #{env.fetch("REDIS_HOST_PORT")}")
  puts("Press Ctrl-C to stop the managed stack.")

  child_pid = Process.spawn(env, "docker", "compose", "up", chdir: APP_ROOT, pgroup: true)
  tmux("set-environment", "-t", session, "GALA_DEV_STACK_PGID", child_pid.to_s, out: File::NULL, err: File::NULL)

  requested_signal = nil
  %w[INT TERM HUP QUIT].each do |signal|
    Signal.trap(signal) { requested_signal ||= signal }
  end

  loop do
    if requested_signal
      exit(shutdown_stack_process_group(session, child_pid, child_pid, requested_signal, requested_signal == "INT" ? 130 : 143))
    end

    waited = reap_child(child_pid)
    if waited
      _pid, status = waited
      exit(finalize_stack_process_group(session, child_pid, child_pid, status))
    end

    sleep(0.25)
  end
rescue Errno::ENOENT
  abort_with("docker is required but was not found on PATH.")
ensure
  clear_stack_pid(session) if session
end

def open_stack(session)
  env = create_session(session)
  open_cheatsheet_for_session(session)

  unless window_exists?(session, DOCKER_WINDOW_NAME)
    stdout, stderr, status = capture_tmux(
      "new-window",
      "-d",
      "-P",
      "-F",
      '#{window_id}',
      "-t",
      session,
      "-n",
      DOCKER_WINDOW_NAME,
      "-c",
      APP_ROOT
    )
    abort_with(stderr.strip.empty? ? "Failed to create #{DOCKER_WINDOW_NAME} tmux window." : stderr.strip) unless status.success?

    window_id = stdout.strip
    tmux!("set-window-option", "-t", window_id, "automatic-rename", "off")
    tmux!("rename-window", "-t", window_id, DOCKER_WINDOW_NAME)
    tmux!("send-keys", "-t", window_id, docker_window_command(env), "C-m")
  end

  puts("Docker stack window: #{session}:#{DOCKER_WINDOW_NAME}")
  puts("BASE_URL=#{env.fetch("BASE_URL")}")
  puts("APP_HOST_PORT=#{env.fetch("APP_HOST_PORT")} REDIS_HOST_PORT=#{env.fetch("REDIS_HOST_PORT")}")
  print_cheatsheet_if_enabled
  attach_or_switch(session, window_name: DOCKER_WINDOW_NAME)
end

  tmux_available!

command = ARGV.shift

case command
when nil
  print_cheatsheet_if_enabled
  interactive
when "help", "--help", "-h"
  puts(usage)
when "list"
  sessions = list_sessions
  if sessions.empty?
    puts("No sessions on tmux server #{SERVER_NAME}.")
  else
    puts(sessions)
  end
when "attach"
  session = sanitize_session_name(ARGV.shift || ENV["GALA_DEV_SESSION"] || DEFAULT_SESSION_NAME)
  abort_with("Session does not exist: #{session}") unless session_exists?(session)

  create_session(session)
  open_cheatsheet_for_session(session)
  print_cheatsheet_if_enabled
  attach_or_switch(session)
when "new", "create"
  session = sanitize_session_name(ARGV.shift || DEFAULT_SESSION_NAME)
  create_session(session)
  open_cheatsheet_for_session(session)
  print_cheatsheet_if_enabled
  attach_or_switch(session)
when "stack"
  session = sanitize_session_name(ARGV.shift || ENV["GALA_DEV_SESSION"] || DEFAULT_SESSION_NAME)
  open_stack(session)
when "run-stack"
  session = sanitize_session_name(ARGV.shift || ENV["GALA_DEV_SESSION"] || DEFAULT_SESSION_NAME)
  run_stack(session)
else
  warn("Unknown command: #{command}")
  puts(usage)
  exit(1)
end
