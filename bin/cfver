#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

CF_API_BASE="${CF_API_BASE:-https://api.cloudflare.com/client/v4}"
CREDENTIAL_FILE="${CLOUDFLARE_CREDENTIAL_FILE:-${CF_CREDENTIAL_FILE:-$REPO_ROOT/dev.learngala.global}}"
CLOUDFLARE_ZONE_NAME="${CLOUDFLARE_ZONE_NAME:-${CF_ZONE_NAME:-learngala.dev}}"
CLOUDFLARE_RECORD_NAME="${CLOUDFLARE_RECORD_NAME:-${CF_RECORD_NAME:-dev.$CLOUDFLARE_ZONE_NAME}}"
CLOUDFLARE_EXPECTED_TARGET="${CLOUDFLARE_EXPECTED_TARGET:-${CF_EXPECTED_TARGET:-${GALA_APP_CDN_DOMAIN:-}}}"
SST_STAGE="${SST_STAGE:-dev}"
AWS_REGION="${AWS_REGION:-us-west-2}"
AWS_PROFILE="${AWS_PROFILE:-gala}"
SYNC_SST_SECRETS="false"
CHECK_DNS_RECORD="true"

usage() {
  cat <<'USAGE'
Usage: bin/cfver [options]

Verifies that this device can authenticate to Cloudflare for learngala.dev.
Credentials are read from the environment first, then from dev.learngala.global.

Expected credential keys:
  CF_ACCOUNT_ID or CLOUDFLARE_ACCOUNT_ID
  CF_ACCESS_TOKEN or CLOUDFLARE_API_TOKEN

Options:
  --credentials-file FILE  Read Cloudflare credentials from FILE.
  --zone NAME              Cloudflare zone name (default: learngala.dev).
  --record NAME            DNS record to inspect (default: dev.<zone>).
  --expected-target HOST   Require the DNS record to point at HOST.
  --stage STAGE            SST stage used with --sync-sst-secrets (default: dev).
  --region REGION          AWS region used with --sync-sst-secrets (default: us-west-2).
  --profile PROFILE        AWS profile used with --sync-sst-secrets (default: gala).
  --sync-sst-secrets       Save account/token into SST secrets for the stage.
  --skip-dns-record        Verify token, account, and zone only.
  --help                   Show this help.

The script never prints token values.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --credentials-file)
      CREDENTIAL_FILE="$2"
      shift 2
      ;;
    --zone)
      CLOUDFLARE_ZONE_NAME="$2"
      shift 2
      ;;
    --record)
      CLOUDFLARE_RECORD_NAME="$2"
      shift 2
      ;;
    --expected-target)
      CLOUDFLARE_EXPECTED_TARGET="$2"
      shift 2
      ;;
    --stage)
      SST_STAGE="$2"
      shift 2
      ;;
    --region)
      AWS_REGION="$2"
      shift 2
      ;;
    --profile)
      AWS_PROFILE="$2"
      shift 2
      ;;
    --sync-sst-secrets)
      SYNC_SST_SECRETS="true"
      shift
      ;;
    --skip-dns-record)
      CHECK_DNS_RECORD="false"
      shift
      ;;
    --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

read_credential() {
  local key="$1"
  local file="$2"
  local line
  local value

  [[ -f "$file" ]] || return 0

  line="$(
    awk -v key="$key" '
      {
        gsub(/\r$/, "")
      }
      /^[[:space:]]*($|#)/ {
        next
      }
      {
        candidate = $0
        sub(/^[[:space:]]*export[[:space:]]+/, "", candidate)
        split(candidate, parts, "=")
        name = parts[1]
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
        if (name == key) {
          sub(/^[^=]*=/, "", candidate)
          print candidate
        }
      }
    ' "$file" | tail -n 1
  )"

  [[ -n "$line" ]] || return 0

  value="$line"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  if [[ "$value" == \"*\" && "$value" == *\" ]]; then
    value="${value#\"}"
    value="${value%\"}"
  elif [[ "$value" == \'*\' && "$value" == *\' ]]; then
    value="${value#\'}"
    value="${value%\'}"
  fi

  printf '%s' "$value"
}

load_cloudflare_credentials() {
  local account_from_file=""
  local token_from_file=""

  account_from_file="$(read_credential "CLOUDFLARE_ACCOUNT_ID" "$CREDENTIAL_FILE")"
  if [[ -z "$account_from_file" ]]; then
    account_from_file="$(read_credential "CF_ACCOUNT_ID" "$CREDENTIAL_FILE")"
  fi

  token_from_file="$(read_credential "CLOUDFLARE_API_TOKEN" "$CREDENTIAL_FILE")"
  if [[ -z "$token_from_file" ]]; then
    token_from_file="$(read_credential "CF_ACCESS_TOKEN" "$CREDENTIAL_FILE")"
  fi

  CLOUDFLARE_ACCOUNT_ID="${CLOUDFLARE_ACCOUNT_ID:-${CF_ACCOUNT_ID:-$account_from_file}}"
  CLOUDFLARE_API_TOKEN="${CLOUDFLARE_API_TOKEN:-${CF_ACCESS_TOKEN:-$token_from_file}}"

  if [[ -z "$CLOUDFLARE_ACCOUNT_ID" ]]; then
    echo "Missing Cloudflare account id. Set CLOUDFLARE_ACCOUNT_ID or CF_ACCOUNT_ID." >&2
    exit 1
  fi

  if [[ -z "$CLOUDFLARE_API_TOKEN" ]]; then
    echo "Missing Cloudflare token. Set CLOUDFLARE_API_TOKEN or CF_ACCESS_TOKEN." >&2
    exit 1
  fi
}

api_get() {
  local path="$1"

  curl --silent --show-error \
    --header "Authorization: Bearer ${CLOUDFLARE_API_TOKEN}" \
    --header "Content-Type: application/json" \
    "${CF_API_BASE}${path}"
}

assert_success() {
  ruby -rjson -e '
    response = JSON.parse(STDIN.read)
    if response["success"]
      exit 0
    end

    errors = response.fetch("errors", []).map do |error|
      [error["code"], error["message"]].compact.join(": ")
    end
    warn(errors.empty? ? "Cloudflare API request failed." : errors.join("; "))
    exit 1
  '
}

normalize_host() {
  local host="$1"

  host="${host#http://}"
  host="${host#https://}"
  host="${host%%/*}"
  host="${host%.}"
  printf '%s' "$host"
}

sync_sst_secret() {
  local name="$1"
  local value="$2"

  printf '%s' "$value" | (
    cd "$REPO_ROOT/infra"
    env AWS_PROFILE="$AWS_PROFILE" AWS_REGION="$AWS_REGION" SST_STAGE="$SST_STAGE" \
      npx sst secret set "$name" --stage "$SST_STAGE"
  )
}

load_cloudflare_credentials

echo "Verifying Cloudflare API token."
token_response="$(api_get "/accounts/${CLOUDFLARE_ACCOUNT_ID}/tokens/verify")"
printf '%s' "$token_response" | assert_success
token_status="$(
  printf '%s' "$token_response" |
    ruby -rjson -e 'puts JSON.parse(STDIN.read).dig("result", "status")'
)"
echo "Token status: ${token_status:-unknown}"
echo "Account token endpoint accepted the configured account id."

echo "Verifying Cloudflare zone access for ${CLOUDFLARE_ZONE_NAME}."
zone_response="$(api_get "/zones?name=${CLOUDFLARE_ZONE_NAME}&account.id=${CLOUDFLARE_ACCOUNT_ID}")"
printf '%s' "$zone_response" | assert_success
zone_id="$(
  printf '%s' "$zone_response" |
    ruby -rjson -e '
      result = JSON.parse(STDIN.read).fetch("result", [])
      abort "Cloudflare zone was not found." if result.empty?
      puts result.fetch(0).fetch("id")
    '
)"
echo "Zone reachable: ${CLOUDFLARE_ZONE_NAME}"

if [[ "$CHECK_DNS_RECORD" == "true" ]]; then
  echo "Inspecting Cloudflare DNS record ${CLOUDFLARE_RECORD_NAME}."
  record_response="$(api_get "/zones/${zone_id}/dns_records?name=${CLOUDFLARE_RECORD_NAME}&type=CNAME")"
  printf '%s' "$record_response" | assert_success
  record_content="$(
    printf '%s' "$record_response" |
      ruby -rjson -e '
        result = JSON.parse(STDIN.read).fetch("result", [])
        abort "Cloudflare CNAME record was not found." if result.empty?
        puts result.fetch(0).fetch("content")
      '
  )"
  record_target="$(normalize_host "$record_content")"
  echo "DNS CNAME target: ${record_target}"

  if [[ -n "$CLOUDFLARE_EXPECTED_TARGET" ]]; then
    expected_target="$(normalize_host "$CLOUDFLARE_EXPECTED_TARGET")"
    if [[ "$record_target" != "$expected_target" ]]; then
      echo "DNS target mismatch: expected ${expected_target}, got ${record_target}." >&2
      exit 1
    fi
    echo "DNS target matches expected CloudFront distribution."
  fi
fi

if [[ "$SYNC_SST_SECRETS" == "true" ]]; then
  echo "Saving Cloudflare credentials to SST secrets for stage '${SST_STAGE}'."
  sync_sst_secret "CLOUDFLARE_ACCOUNT_ID" "$CLOUDFLARE_ACCOUNT_ID"
  sync_sst_secret "CLOUDFLARE_API_TOKEN" "$CLOUDFLARE_API_TOKEN"
  echo "SST Cloudflare secrets saved."
fi

echo "Cloudflare verification passed."
