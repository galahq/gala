#!/usr/bin/env bash

set -euo pipefail

APP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INFRA_DIR="${APP_ROOT}/infra"

PROFILE="${AWS_PROFILE:-gala}"
REGION="${AWS_REGION:-us-west-2}"
STAGE="${SST_STAGE:-dev}"
COMMAND=""

usage() {
  cat <<'USAGE'
Usage:
  bin/sst-db [options] tunnel
  bin/sst-db [options] connect [psql-args...]
  bin/sst-db [options] check

Commands:
  tunnel     Start the SST managed tunnel for the selected stage.
  connect    Fetch /gala/STAGE/DATABASE_URL from SSM and exec psql.
  check      Run a quick psql connection identity query.

Options:
  --profile PROFILE   AWS profile to use. Default: AWS_PROFILE or gala.
  --region REGION     AWS region to use. Default: AWS_REGION or us-west-2.
  --stage STAGE       SST stage to use. Default: SST_STAGE or dev.
  --help              Show this help.

Examples:
  bin/sst-db --stage dev tunnel
  bin/sst-db --stage dev connect
  bin/sst-db --stage production tunnel
  bin/sst-db --stage production connect
  bin/sst-db --profile gala --region us-west-2 --stage dev check

Run tunnel and connect in separate terminals. The connect command hands the
current terminal over to psql with exec, so exiting psql exits the command.
USAGE
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

stage_database_parameter_name() {
  printf '/gala/%s/DATABASE_URL' "$STAGE"
}

database_url() {
  env -u DATABASE_URL \
    AWS_PROFILE="$PROFILE" \
    AWS_REGION="$REGION" \
    SST_STAGE="$STAGE" \
    aws ssm get-parameter \
      --region "$REGION" \
      --profile "$PROFILE" \
      --name "$(stage_database_parameter_name)" \
      --with-decryption \
      --query Parameter.Value \
      --output text
}

run_tunnel() {
  require_command npx

  cd "$INFRA_DIR"
  exec env \
    AWS_PROFILE="$PROFILE" \
    AWS_REGION="$REGION" \
    SST_STAGE="$STAGE" \
    npx sst tunnel --stage "$STAGE"
}

run_connect() {
  require_command aws
  require_command psql

  local url
  url="$(database_url)"
  if [[ -z "$url" || "$url" == "None" ]]; then
    echo "Could not resolve $(stage_database_parameter_name)." >&2
    exit 1
  fi

  exec env -u DATABASE_URL psql "$url" "$@"
}

run_check() {
  run_connect -Atc "select current_database(), current_user, inet_server_addr()::text, inet_server_port();"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      PROFILE="$2"
      shift 2
      ;;
    --region)
      REGION="$2"
      shift 2
      ;;
    --stage)
      STAGE="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    tunnel|connect|check)
      COMMAND="$1"
      shift
      break
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ -z "$COMMAND" ]]; then
  usage >&2
  exit 1
fi

case "$COMMAND" in
  tunnel)
    run_tunnel "$@"
    ;;
  connect)
    run_connect "$@"
    ;;
  check)
    run_check "$@"
    ;;
esac
