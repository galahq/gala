#!/bin/bash

PATH_add bin

dotenv_if_exists .env
dotenv_if_exists .env.dev
dotenv_if_exists dev.learngala.global

if [[ -n "${CF_ACCOUNT_ID:-}" && -z "${CLOUDFLARE_ACCOUNT_ID:-}" ]]; then
  export CLOUDFLARE_ACCOUNT_ID="$CF_ACCOUNT_ID"
fi

if [[ -n "${CLOUDFLARE_ACCOUNT_ID:-}" && -z "${CLOUDFLARE_DEFAULT_ACCOUNT_ID:-}" ]]; then
  export CLOUDFLARE_DEFAULT_ACCOUNT_ID="$CLOUDFLARE_ACCOUNT_ID"
fi

if [[ -n "${CF_ACCESS_TOKEN:-}" && -z "${CLOUDFLARE_API_TOKEN:-}" ]]; then
  export CLOUDFLARE_API_TOKEN="$CF_ACCESS_TOKEN"
fi
