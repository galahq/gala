<%= content_for :title, I18n.t('devise.passwords.new.forgot_your_password') %>
<h2><%= t '.forgot_your_password' %></h2>
<%= form_for(resource, as: resource_name, url: password_path(resource_name), builder: BlueprintFormBuilder, html: { method: :post }) do |f| %>
  <%= f.errors %>
  <%= f.form_group :email do |f, error_classes| %>
    <%= f.email_field :email, class: %w[pt-input pt-fill] + error_classes, spellcheck: false %>
  <% end %>
  <%= f.submit t('.send_me_reset_password_instructions'), class: %w[pt-intent-primary bp4-intent-primary] %>
<% end %>
<%= render "devise/shared/links" %>
