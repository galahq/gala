<% content_for :title, I18n.t('devise.registrations.new.sign_up') %>
<div>
  <div class="pt-card bp4-card pt-elevation-4 bp4-elevation-4 devise-card">
    <h2><%= t('.sign_up') %></h2>
    <%= form_for resource, as: resource_name, url: registration_path(resource_name), builder: BlueprintFormBuilder do |f| %>
      <%= f.errors %>
      <%= f.form_group :name %>
      <%= f.form_group :locale do |f, error_classes| %>
        <div class="pt-select bp4-html-select pt-fill bp4-fill <%= error_classes %>">
          <%= f.select :locale, options_for_select(locale_names, I18n.locale) %>
        </div>
      <% end %>
      <%= f.form_group :email do |f, error_classes| %>
        <%= f.email_field :email, class: (%w[pt-input pt-fill] + error_classes), spellcheck: false %>
      <% end %>
      <% min_length = t 'devise.shared.minimum_password_length', count: @minimum_password_length %>
      <%= f.form_group :password, in_parens: min_length do |f, error_classes| %>
        <%= f.public_send(:"#{'password'}_field", :password, class: (%w[pt-input pt-fill] + error_classes), autocomplete: "new-password") %>
      <% end %>
      <%= f.form_group :password_confirmation do |f, error_classes| %>
        <%= f.public_send(:"#{'password'}_field", :password_confirmation, class: %w[pt-input pt-fill] + error_classes, autocomplete: "new-password") %>
      <% end %>
      <%= f.submit t('.sign_up'), class: %w[pt-intent-primary bp4-intent-primary] %>
      <% if Rails.configuration.x.temporary_unconfirmed_access == 'false' %>
        <a class="pt-button bp4-button pt-icon-log-in oauth-icon-google" role="button" tabindex="0" href="<%= omniauth_authorize_path('authentication_strategy', 'google') %>">
          <%= t('devise.shared.links.sign_in_with_provider', provider: 'Google') %>
        </a>
      <% else %>
        <a class="pt-button bp4-button pt-icon-log-in oauth-icon-google pt-disabled bp4-disabled" role="button" tabindex="-1" href="javascript:void(0)" style="pointer-events: none; opacity: 0.6;">
          <%= t('devise.shared.links.sign_in_with_provider', provider: 'Google') %>
        </a>
      <% end %>
    <% end %>
    <%= render "devise/shared/links" %>
  </div>
</div>
