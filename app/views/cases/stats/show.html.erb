
<% content_for :title do %>
  <%= I18n.t('cases.stats.show.case_stats') %> — <%= @case.short_title %>
<% end %>

<div class="window admin">
  <div class="admin-card admin-card--wide bp6-card bp6-elevation-2">
    <%= link_to case_path(@case) do %>
      <div class="case-cover-card-top" style="background-image: url(<%= @case.cover_url %>)">
        <span class="admin__table__slug"><%= @case.short_title %></span>
      </div>
    <% end %>

    <main>
      <h1 class="admin__title"><%= t('.case_stats') %></h1>

      <div id="stats-overview">
        <%= raw @cached_overview_html %>
      </div>

      <div
        data-controller="case-stats"
        data-url="<%= case_stats_path(@case) %>"
        data-min-date="<%= @case.created_at.to_date.iso8601 %>"
        data-case-id="<%= @case.id %>">
        <!-- StatsPage React component mounts here -->
      </div>

      <%# A condition of the CC BY 4.0 licence on the country database these %>
      <%# figures come from, so it belongs on the page that shows them. %>
      <p class="bp6-text-muted bp6-text-small">
        <%= link_to 'IP Geolocation by DB-IP', 'https://db-ip.com',
                    target: '_blank', rel: 'noopener noreferrer' %>
      </p>
    </main>
  </div>
</div>
