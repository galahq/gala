<% content_for :title do %>
  <%= I18n.t('cases.deletions.new.confirm_deletion') %>
  —
  <%= @case.short_title %>
<% end %>
<div class="window admin">
  <div class="admin-card pt-card pt-elevation-2">
    <%= link_to case_path @case do %>
      <div class="case-cover-card-top" style="background-image: url(<%= @case.cover_url %>)">
        <span class="admin__table__slug">
          <%= @case.short_title %>
        </span>
      </div>
    <% end %>
    <div>
      <h1 class="admin__title"><%= t '.are_you_sure' %></h1>
      <div class="pt-running-text"><%= raw markdown t '.this_action_cannot_be_undone' %></div>
    </div>
    <%= form_for @confirm_deletion_form, url: case_confirm_deletion_path, data: { gala_controller: 'confirmation' }, builder: BlueprintFormBuilder do |f| %>
      <%= f.errors %>
      <% if @confirm_deletion_form.needs_confirmation? %>
        <%= f.form_group :kicker_confirmation do |f, error_classes| %>
          <%= f.text_field :kicker_confirmation, class: %w[pt-input pt-fill] + error_classes, data: { gala_action: 'input->confirmation#check', expected: @confirm_deletion_form.case.kicker } %>
        <% end %>
      <% else %>
        <%= f.hidden_field :kicker_confirmation %>
      <% end %>
      <%= f.submit disabled: @confirm_deletion_form.needs_confirmation?, class: %i[pt-fill pt-intent-danger], data: { gala_target: 'confirmation.submit' } %>
    <% end %>
  </div>
</div>
