<%= form_for kase, url: case_settings_path(kase), builder: BlueprintFormBuilder, html: { onsubmit: 'return handleSubmit();' } do |f| %>
  <%= f.form_group :license do |f, error_classes| %>
    <div class="pt-control-group bp4-control-group">
      <div class="pt-select bp4-html-select pt-fill bp4-fill <%= error_classes %>">
        <%= f.select :license, kase.available_licenses.map { |l| [l['name'], l['id']]  }, include_blank: false %>
      </div>
      <%= f.submit I18n.t('cases.settings.edit.change_license'), class: %w[pt-button bp4-button pt-intent-success bp4-intent-success], id: 'case_license_submit' %>
    </div>
    <a class="pt-button bp4-button pt-minimal bp4-minimal license pt-icon-help" href="https://docs.learngala.com/docs/general-licensing" target="_blank">
      <%= I18n.t('cases.settings.edit.learn_more_license') %>
    </a>
  <% end %>
<% end %>
<script>
  function handleSubmit() {
    if (<%= current_user.has_role?(:editor) %>) return true;
    var originalValue = '<%= kase.license %>';
    var newValue = document.querySelector('#case_license').value;
    if (originalValue === 'all_rights_reserved' && originalValue !== newValue) {
      if (confirm('<%= I18n.t('cases.settings.edit.change_license_confirmation') %>')) {
        return true;
      } else {
        setTimeout(function(){document.querySelector('#case_license_submit').disabled = false;},100);
        return false;
      }
    }
    return true;
  }
</script>
