%noscript
  .bp6-running-text.bp6-dark
    %h1
      = succeed ':' do
        = kase.short_title
      = kase.title

    %h2= kase.dek

    %p
      %em= kase.authors.map { |a| a[:name] }.to_sentence

    %p= kase.summary

    .bp6-callout.bp6-intent-danger.bp6-icon-error
      Javascript is required to use Gala.
