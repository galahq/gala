.personas
  .personas__welcome.bp6-dark.bp6-running-text
    %h1.personas__headline= t '.welcome'
    %p.personas__intro= t '.tell_us_about_yourself'

  .personas__choices
    - %i[learner teacher writer].each do |persona|
      .bp6-card.bp6-elevation-4.personas__choice{ class: "persona--#{persona}" }
        %h2.personas__choice-title{ id: "persona-#{persona}-title" }= t "personas.#{persona}.title"
        %p.personas__choice-description= t "personas.#{persona}.description"

        = form_with url: profile_persona_path, method: :put, local: true do |f|
          = f.hidden_field :persona, value: persona

          - intents = { learner: 'primary',
                        teacher: 'warning',
                        writer: 'success' }
          = f.submit 'Choose',
                     'class' => "bp6-button bp6-intent-#{intents[persona]} personas__choice-button",
                     'aria-labelledby' => "persona-#{persona}-title"

  %p.personas__skip
    = link_to t('.ill_figure_it_out'), root_path
    %br
    = t '.you_can_opt_in_later'
