-# Shown only to visitors GeoIp places in the EU, the EEA or the UK who have
-# not answered yet — see ConsentHelper#show_consent_banner?. Rendered from the
-# body of the application layout, which every other layout nests inside via
-# parent_layout, so it appears until it is answered and then never again.
.consent-banner{ data: { controller: 'consent' }, role: 'region',
                 'aria-label': t('.heading') }
  .consent-banner__text
    %strong= t('.heading')
    %p= t('.body')
  .consent-banner__actions
    = link_to t('.policies'), 'https://docs.learngala.com/policies',
              class: 'consent-banner__link', target: '_blank',
              rel: 'noopener noreferrer'
    %button.bp6-button{ type: 'button', data: { action: 'consent#decline' } }
      = t('.decline')
    %button.bp6-button.bp6-intent-primary{ type: 'button',
                                           data: { action: 'consent#accept' } }
      = t('.accept')
