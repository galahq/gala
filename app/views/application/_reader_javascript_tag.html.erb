<%= javascript_tag do %>
  window.reader = <% if reader_signed_in? %>
  <%=
    raw ActiveModel::Serializer.for(
      current_reader.decorate,
      view_context: controller.view_context,
      force_spotlight_acknowledgements:
        spotlight_acknowledgements_on_first_login?
    ).to_json
  %>
  <% else %>
  undefined;
  <% end %>
<% end %>
