<div id="unsupported-browser" style="display: none">
  <div class="pt-callout pt-intent-danger pt-icon-error">
    <h1 class="pt-callout-title">Unsupported Browser</h1>
    <!-- Unknown filter: markdown -->
    Unfortunately, Gala does not support Internet Explorer and may not work as
intended. Please try [Mozilla Firefox](https://www.mozilla.org/firefox/)
or [Google Chrome](https://www.google.com/chrome/).


  </div>
</div>
<script>
  try {
    if (navigator.userAgent.match(/MSIE|Trident/)) {
      var warning = document.getElementById('unsupported-browser')
      warning.style.display = "block"
    }
  }
  catch(e) { /* Ignore errors */ }
</script>
