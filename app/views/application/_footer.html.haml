%footer.footer
  .footer__container
    .footer__copyright
      © 2016 –
      = Time.zone.now.year
      The University of Notre Dame and The Regents of the University of Michigan
    .footer__links
      = link_to t('.policies'), 'https://docs.learngala.com/policies',
                target: '_blank', rel: 'noopener noreferrer'
      -# The way back to the consent banner, for visitors who were asked. This
         footer renders only in the with_header layout, so it is reachable from
         any page via the logo rather than present on every page.
      - if show_consent_withdrawal?
        = link_to t('.cookies'), '#', data: { controller: 'consent',
                                              action: 'consent#reopen' }
      = link_to 'Get Help', 'https://docs.learngala.com',
                target: '_blank', rel: 'noopener noreferrer'
      = link_to 'Open Source', 'https://github.com/galahq/gala',
                target: '_blank', rel: 'noopener noreferrer'
      -# Required by the CC BY 4.0 licence on the country database GeoIp reads.
      = link_to 'IP Geolocation by DB-IP', 'https://db-ip.com',
                target: '_blank', rel: 'noopener noreferrer'
      - if ENV['RELEASE'].present?
        %a.footer__release{ href: "https://github.com/galahq/gala/releases/tag/#{ENV['RELEASE']}" }
          = ENV['RELEASE']
