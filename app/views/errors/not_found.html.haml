- content_for :title, '404 Not Found'

.bp6-dark.bp6-dark
  .bp6-non-ideal-state.bp6-non-ideal-state
    .bp6-non-ideal-state-visual
      %span.bp6-icon.bp6-icon.bp6-icon-error.bp6-icon-error

    %h4.bp6-heading Not Found

    %div
      %p
        The page you were looking for doesn’t exist.
        %br
        Try searching to find what you’re looking for.

      %div
        = form_with url: '/catalog/search', local: true, method: :get do
          .bp6-input-group.bp6-input-group.bp6-round.bp6-round
            %span.bp6-icon.bp6-icon.bp6-icon-search.bp6-icon-search
            %input.bp6-input.bp6-input{ name: "q",
                                        placeholder: I18n.t('search.search_cases'),
                                        type: "text" }
              %span.bp6-input-action.bp6-input-action
              %button.bp6-button.bp6-button.bp6-minimal.bp6-minimal.bp6-icon-arrow-right.bp6-icon-arrow-right(type="submit")
