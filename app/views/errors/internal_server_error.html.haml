- content_for :title, '500 Internal Server Error'

:javascript
  function reportFeedback () {
    Sentry.showReportDialog(#{raw report_dialog_options.to_json})
  }

.pt-dark.bp4-dark
  .pt-non-ideal-state.bp4-non-ideal-state
    .pt-non-ideal-state-visual.bp4-non-ideal-state-visual.pt-non-ideal-state-icon.bp4-non-ideal-state-icon
      %span.pt-icon.bp4-icon.pt-icon-error.bp4-icon-error

    %h4.pt-non-ideal-state-title.bp4-non-ideal-state-title 500 Internal Server Error

    .pt-non-ideal-state-description.bp4-non-ideal-state-description
      %p That’s not supposed to happen.

    .pt-non-ideal-state-action.bp4-non-ideal-state-action
      %button.pt-button.bp4-button.pt-intent-primary.bp4-intent-primary.pt-icon-comment.bp4-icon-comment{ type: "button",
                                                                                                          onclick: 'reportFeedback()'}
        Report Feedback
