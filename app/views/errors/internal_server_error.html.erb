<% content_for :title, '500 Internal Server Error' %>
<script>
  function reportFeedback () {
    Sentry.showReportDialog(<%= raw report_dialog_options.to_json %>)
  }
  
</script>
<div class="pt-dark bp4-dark">
  <div class="pt-non-ideal-state bp4-non-ideal-state">
    <div class="pt-non-ideal-state-visual bp4-non-ideal-state-visual pt-non-ideal-state-icon bp4-non-ideal-state-icon">
      <span class="pt-icon bp4-icon pt-icon-error bp4-icon-error"></span>
    </div>
    <h4 class="pt-non-ideal-state-title bp4-non-ideal-state-title">500 Internal Server Error</h4>
    <div class="pt-non-ideal-state-description bp4-non-ideal-state-description">
      <p>That’s not supposed to happen.</p>
    </div>
    <div class="pt-non-ideal-state-action bp4-non-ideal-state-action">
      <button class="pt-button bp4-button pt-intent-primary bp4-intent-primary pt-icon-comment bp4-icon-comment" type="button" onclick="reportFeedback()">
        Report Feedback
      </button>
    </div>
  </div>
</div>
