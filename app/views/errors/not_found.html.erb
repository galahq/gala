<% content_for :title, '404 Not Found' %>
<div class="pt-dark bp4-dark">
  <div class="pt-non-ideal-state bp4-non-ideal-state">
    <div class="pt-non-ideal-state-visual bp4-non-ideal-state-visual pt-non-ideal-state-icon bp4-non-ideal-state-icon">
      <span class="pt-icon bp4-icon pt-icon-error bp4-icon-error"></span>
    </div>
    <h4 class="pt-non-ideal-state-title bp4-non-ideal-state-title">Not Found</h4>
    <div class="pt-non-ideal-state-description bp4-non-ideal-state-description">
      <p>
        The page you were looking for doesn’t exist.
        <br>
        Try searching to find what you’re looking for.
      </p>
      <div class="pt-non-ideal-state-action bp4-non-ideal-state-action">
        <%= form_with url: '/catalog/search', local: true, method: :get do %>
          <div class="pt-input-group bp4-input-group pt-round bp4-round">
            <span class="pt-icon bp4-icon pt-icon-search bp4-icon-search"></span>
            <input class="pt-input bp4-input" name="q" placeholder="<%= I18n.t('search.search_cases') %>" type="text">
              <span class="pt-input-action bp4-input-action"></span>
              <button class="pt-button bp4-button pt-minimal bp4-minimal pt-icon-arrow-right bp4-icon-arrow-right" type="submit"></button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
