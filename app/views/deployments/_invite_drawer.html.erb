<div class="deployment__invite__drawer" data-gala-controller="clipboard">
  <div class="deployment__invite__instructions">
    <%= t '.invite_instructions_html' %>
  </div>

  <div class="deployment__invite__link pt-control-group bp4-control-group">
    <div class="pt-input-group bp4-input-group pt-fill bp4-fill">
      <span class="pt-icon bp4-icon pt-icon-new-person bp4-icon-new-person"></span>
      <input
        aria-label="<%= I18n.t 'deployments.deployment.invite_link',
                               case_kicker: deployment.case.short_title,
                               group_name: deployment.group.name %>"
        class="pt-input bp4-input"
        data-gala-target="clipboard.source"
        value="<%= deployment.magic_link %>"
      />
    </div>
    <button class="pt-button bp4-button pt-icon-clipboard bp4-icon-clipboard" data-gala-action="clipboard#copy">
      <%= t 'helpers.copy' %>
    </button>
  </div>
</div>
