- content_for :title, I18n.t('deployments.index.teach_with_cases')


.admin.md-container.bp6-dark.bp6-dark
  %header.md-header
    %h1.admin__title= t '.teach_with_cases'

  %aside.md-master.spaced
    %h2.admin__title= t '.deploy_a_case'
    .bp6-running-text.bp6-running-text= raw markdown t '.instructions'

    .bp6-callout.bp6-callout.bp6-icon-hand-right.bp6-icon-hand-right
      = t '.find_a_case_then_click_teach_this_case'

    = form_with url: '/catalog/search', local: true, method: :get do
      .bp6-input-group.bp6-input-group.bp6-round.bp6-round
        %span.bp6-icon.bp6-icon.bp6-icon-search.bp6-icon-search
        %input.bp6-input.bp6-input{ type: 'text', name: 'q',
                                   role: 'search',
                                   placeholder: I18n.t('search.search_cases'),
                                   'aria-label': I18n.t('search.search_cases')}
          %span.bp6-input-action.bp6-input-action
            %button.bp6-button.bp6-button.bp6-minimal.bp6-minimal.bp6-icon-arrow-right.bp6-icon-arrow-right{type:"submit",'aria-label': I18n.t('search.submit_search')}

  %main.md-detail
    - if deployments.empty?
      .bp6-non-ideal-state.bp6-non-ideal-state
        .bp6-non-ideal-state-visual.bp6-non-ideal-state-visual.pt-non-ideal-state-icon.bp4-non-ideal-state-icon
          %span.bp6-icon.bp6-icon.bp6-icon-folder-open.bp6-icon-folder-open
        %h3.bp6-heading= t '.youre_not_teaching_any_cases'
        %div= t '.once_youve_deployed'

    -else
      .spaced
        - deployments.grouped.each do |group, group_deployments|
          %h2.deployments__group= group.name

          - group_deployments.each do |deployment|
            = render deployment
