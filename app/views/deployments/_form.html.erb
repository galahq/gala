<%= form_for deployment, builder: BlueprintFormBuilder, data: { gala_controller: 'select-new'} do |f| %>
  <%= f.errors %>
  <%= f.hidden_field :case_id %>
  <%= f.form_group :group_id do |f| %>
    <div class="pt-select bp4-html-select pt-fill bp4-fill">
      <%= f.select :group_id, options_for_group_select, {include_blank: t('.select_a_group')}, data: { gala_action: 'select-new#toggleFormVisibility' } %>
    </div>
  <% end %>
  <div class="new-group" data-gala-target="select-new.form">
    <%= f.fields_for :group do |f| %>
      <%= f.form_group :name do |f, err| %>
        <%= f.text_field :name, disabled: true, data: { gala_target: 'select-new.input' }, class: %w[pt-input bp4-input pt-fill bp4-fill] + err %>
      <% end %>
    <% end %>
  </div>
  <%= f.submit class: %w[pt-button bp4-button pt-intent-primary bp4-intent-primary] %>
<% end %>
