<% content_for :title, I18n.t('deployments.index.teach_with_cases') %>
<div class="admin md-container pt-dark bp4-dark">
  <header class="md-header">
    <h1 class="admin__title"><%= t '.teach_with_cases' %></h1>
  </header>
  <aside class="md-master spaced">
    <h2 class="admin__title"><%= t '.deploy_a_case' %></h2>
    <div class="pt-running-text bp4-running-text"><%= raw markdown t '.instructions' %></div>
    <div class="pt-callout bp4-callout pt-icon-hand-right bp4-icon-hand-right">
      <%= t '.find_a_case_then_click_teach_this_case' %>
    </div>
    <%= form_with url: '/catalog/search', local: true, method: :get do %>
      <div class="pt-input-group bp4-input-group pt-round bp4-round">
        <span class="pt-icon bp4-icon pt-icon-search bp4-icon-search"></span>
        <input class="pt-input bp4-input" type="text" name="q" role="search" placeholder="<%= I18n.t('search.search_cases') %>" aria-label="<%= I18n.t('search.search_cases') %>">
          <span class="pt-input-action bp4-input-action">
            <button class="pt-button bp4-button pt-minimal bp4-minimal pt-icon-arrow-right bp4-icon-arrow-right" type="submit" aria-label="<%= I18n.t('search.submit_search') %>"></button>
          </span>
      </div>
    <% end %>
  </aside>
  <main class="md-detail">
    <% if deployments.empty? %>
      <div class="pt-non-ideal-state bp4-non-ideal-state">
        <div class="pt-non-ideal-state-visual bp4-non-ideal-state-visual pt-non-ideal-state-icon bp4-non-ideal-state-icon">
          <span class="pt-icon bp4-icon pt-icon-folder-open bp4-icon-folder-open"></span>
        </div>
        <h3 class="pt-non-ideal-state-title bp4-non-ideal-state-title"><%= t '.youre_not_teaching_any_cases' %></h3>
        <div class="pt-non-ideal-state-description bp4-non-ideal-state-description"><%= t '.once_youve_deployed' %></div>
      </div>
    <% else %>
      <div class="spaced">
        <% deployments.grouped.each do |group, group_deployments| %>
          <h2 class="deployments__group"><%= group.name %></h2>
          <% group_deployments.each do |deployment| %>
            <%= render deployment %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </main>
</div>
