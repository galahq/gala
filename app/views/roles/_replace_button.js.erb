/* @noflow */

var button = document
  .querySelector(
    '[data-reader-id="<%= reader.id %>"] form [data-role-id="<%= role.id %>"]'
  )

var newButton = document.createElement('div')
newButton.innerHTML = '<%= j toggle_role_button(reader, role) %>'

if (button != null) button.parentNode.replaceWith(newButton)
