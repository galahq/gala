<% content_for :title, I18n.t('my_cases.index.my_cases') %>
<div class="admin md-container">
  <header class="md-header pt-dark bp4-dark">
    <h1 class="admin__title">
      <%= t '.my_cases' %>
    </h1>
  </header>
  <aside class="md-master">
    <div class="pt-dark bp4-dark">
      <h2 class="admin__title">
        <%= t '.create_a_case' %>
        <%= link_to 'https://docs.learngala.com/docs/', class: %i[pt-button bp4-button pt-minimal bp4-minimal pt-icon-help bp4-icon-help], aria: { label: I18n.t('helpers.help') }, target: '_blank', rel: 'noopener noreferrer' do %>
        <% end %>
      </h2>
      <!-- Unknown filter: markdown -->
      #{t '.put_your_own_cases_on_gala'}

      <div class="pt-callout bp4-callout pt-icon-hand-right bp4-icon-hand-right">
        <%= t '.publish_with_a_creative_commons_license' %>
        <div class="my-cases__link">
          <%= link_to t('my_cases.index.learn_more'), 'https://docs.learngala.com/docs/general-licensing' %>
        </div>
      </div>
    </div>
    <% if reader_signed_in? %>
      <div class="pt-dark bp4-dark">
        <%= form_with model: Case.new, local: true do |f| %>
          <div class="spaced">
            <%= f.submit I18n.t('my_cases.index.new_case'), class: 'pt-button bp4-button pt-intent-success bp4-intent-success pt-icon-add bp4-icon-add my-cases__v-align-top' %>
            <div class="pt-select bp4-select">
              <%= f.select :locale, options_for_select(locale_names, current_user.locale) %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="pt-card bp4-card pt-elevation-4 bp4-elevation-4 devise-card">
        <%= render 'devise/sessions/sign_in', resource: Reader.new %>
      </div>
    <% end %>
  </aside>
  <main class="md-detail pt-dark bp4-dark">
    <% if @cases.any? %>
      <table class="admin__table pt-html-table bp4-html-table my-cases__table">
        <thead>
          <td></td>
          <td><%= t 'activerecord.attributes.case.case_title' %></td>
          <% if @show_first_editor %>
            <td><%= t 'activerecord.attributes.case.first_editor' %></td>
          <% else %>
            <td><%= t 'activerecord.attributes.case.slug' %></td>
          <% end %>
          <td><%= t 'activerecord.attributes.case.locale' %></td>
          <td><%= t 'activerecord.attributes.case.library' %></td>
          <td><%= t 'activerecord.attributes.case.published' %></td>
          <td><%= t 'my_cases.index.case_stats' %></td>
          <td></td>
          <td></td>
          <td></td>
        </thead>
        <tbody>
          <% @cases.each do |kase| %>
            <tr>
              <td>
                <img class="admin__table__thumbnail" src="<%= kase.small_cover_url %>" role="presentation">
              </td>
              <td>
                <%= link_to case_path kase do %>
                  <span class="admin__table__slug">
                    <%= kase.short_title %>
                    <% if kase.featured? %>
                      <span class="pt-tag bp4-tag pt-minimal bp4-minimal pt-intent-success bp4-intent-success">
                        <%= "#{t('.featured')}:" %>
                        <%= localize kase.featured_at.to_date %>
                      </span>
                    <% end %>
                  </span>
                  <%= kase.title %>
                <% end %>
              </td>
              <% if @show_first_editor %>
                <td><%= @first_editor_names_by_case_id[kase.id] || '—' %></td>
              <% else %>
                <td>
                  <%= link_to case_path kase do %>
                    <code><%= kase.slug %></code>
                  <% end %>
                </td>
              <% end %>
              <td><%= Translation.language_name kase.locale %></td>
              <td><%= kase.library.name %></td>
              <td title="<%= kase.published_at %>">
                <% if kase.published? %>
                  <%= localize kase.published_at.to_date, format: :long %>
                <% else %>
                  —
                <% end %>
              </td>
              <td>
                <%= link_to '', case_stats_path(kase), aria: { label: t('.case_stats') }, class: 'pt-button bp4-button pt-minimal bp4-minimal pt-icon-series-search bp4-icon-series-search' %>
              </td>
              <td>
                <%= link_to '', edit_case_path(kase), aria: { label: t('.edit_case') }, class: 'pt-button bp4-button pt-minimal bp4-minimal pt-icon-edit bp4-icon-edit' %>
              </td>
              <td>
                <%= link_to '', edit_case_settings_path(kase), aria: { label: t('.edit_case_settings') }, class: 'pt-button bp4-button pt-minimal bp4-minimal pt-icon-cog bp4-icon-cog' %>
              </td>
              <td>
                <%= link_to '', case_confirm_deletion_path(kase), class: 'pt-button bp4-button pt-minimal bp4-minimal pt-intent-danger bp4-intent-danger pt-icon-trash bp4-icon-trash', aria: { label: t('.delete_case') } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="pt-non-ideal-state bp4-non-ideal-state">
        <div class="pt-non-ideal-state-visual bp4-non-ideal-state-visual pt-non-ideal-state-icon bp4-non-ideal-state-icon">
          <span class="pt-icon bp4-icon pt-icon-folder-open bp4-icon-folder-open"></span>
        </div>
        <h4 class="pt-non-ideal-state-title bp4-non-ideal-state-title">
          <%= t '.youre_not_authoring_any_cases' %>
        </h4>
        <div class="pt-non-ideal-state-description bp4-non-ideal-state-description">
          <%= t '.once_youve_created' %>
        </div>
      </div>
    <% end %>
  </main>
</div>
