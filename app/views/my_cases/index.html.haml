- content_for :title, I18n.t('my_cases.index.my_cases')


.admin.md-container
  %header.md-header.bp6-dark.bp6-dark
    %h1.admin__title
      = t '.my_cases'

  %aside.md-master
    .bp6-dark.bp6-dark
      %h2.admin__title
        = t '.create_a_case'
        = link_to 'https://docs.learngala.com/docs/',
                  class: %i[bp6-button bp6-button bp6-minimal bp6-minimal bp6-icon-help bp6-icon-help],
                  aria: { label: I18n.t('helpers.help') },
                  target: '_blank', rel: 'noopener noreferrer' do
          -# Empty
      :markdown
        #{t '.put_your_own_cases_on_gala'}
      .bp6-callout.bp6-callout.bp6-icon-hand-right.bp6-icon-hand-right
        = t '.publish_with_a_creative_commons_license'
        .my-cases__link
          = link_to t('my_cases.index.learn_more'), 'https://docs.learngala.com/docs/general-licensing'

    - if reader_signed_in?
      .bp6-dark.bp6-dark
        = form_with model: Case.new, local: true do |f|

          .spaced
            = f.submit I18n.t('my_cases.index.new_case'),
                      class: 'bp6-button bp6-button bp6-intent-success bp6-intent-success bp6-icon-add bp6-icon-add my-cases__v-align-top'
            .bp6-html-select
              = f.select :locale, options_for_select(locale_names,
                                                    current_user.locale)
    - else
      .bp6-card.bp6-card.bp6-elevation-4.bp6-elevation-4.devise-card
        = render 'devise/sessions/sign_in', resource: Reader.new


  %main.md-detail.bp6-dark.bp6-dark
    - if @cases.any?
      %table.admin__table.bp6-html-table.bp6-html-table.my-cases__table
        %thead
          %td
          %td= t 'activerecord.attributes.case.case_title'
          - if current_reader.has_role? :editor
            %td= t 'activerecord.attributes.case.first_editor'
          - else
            %td= t 'activerecord.attributes.case.slug'
          %td= t 'activerecord.attributes.case.locale'
          %td= t 'activerecord.attributes.case.library'
          %td= t 'activerecord.attributes.case.published'
          %td= t 'my_cases.index.case_stats'
          %td
          %td
          %td

        %tbody
          -@cases.each do |kase|
            %tr
              %td
                %img.admin__table__thumbnail{ src: kase.small_cover_url,
                                              role: 'presentation' }

              %td
                = link_to case_path kase do
                  %span.admin__table__slug
                    = kase.short_title
                    - if kase.featured?
                      %span.bp6-tag.bp6-tag.bp6-minimal.bp6-minimal.bp6-intent-success.bp6-intent-success
                        = succeed ':' do
                          = t '.featured'
                        = localize kase.featured_at.to_date
                  = kase.title

              - if current_reader.has_role? :editor
                %td= kase.editorships.first&.editor_name
              - else
                %td
                  = link_to case_path kase do
                    %code= kase.slug

              %td= Translation.language_name kase.locale

              %td= kase.library.name

              %td{title: kase.published_at}
                - if kase.published?
                  = localize kase.published_at.to_date, format: :long
                - else
                  —
              %td
                = link_to '', case_stats_path(kase),
                          aria: { label: t('.case_stats') },
                          class: 'bp6-button bp6-button bp6-minimal bp6-minimal bp6-icon-series-search bp6-icon-series-search'


              %td
                = link_to '', edit_case_path(kase),
                          aria: { label: t('.edit_case') },
                          class: 'bp6-button bp6-button bp6-minimal bp6-minimal bp6-icon-edit bp6-icon-edit'

              %td
                = link_to '', edit_case_settings_path(kase),
                          aria: { label: t('.edit_case_settings') },
                          class: 'bp6-button bp6-button bp6-minimal bp6-minimal bp6-icon-cog bp6-icon-cog'

              %td
                = link_to '', case_confirm_deletion_path(kase),
                          class: 'bp6-button bp6-button bp6-minimal bp6-minimal bp6-intent-danger bp6-intent-danger bp6-icon-trash bp6-icon-trash',
                          aria: { label: t('.delete_case') }



    - else
      .bp6-non-ideal-state.bp6-non-ideal-state
        .bp6-non-ideal-state-visual
          %span.bp6-icon.bp6-icon.bp6-icon-folder-open.bp6-icon-folder-open
        %h4.bp6-heading
          = t '.youre_not_authoring_any_cases'
        %div
          = t '.once_youve_created'
