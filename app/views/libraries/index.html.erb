<% content_for :title, I18n.t('libraries.index.libraries') %>
<div class="admin md-container">
  <header class="md-header pt-dark">
    <h1 class="admin__title">
      <%= t '.libraries' %>
    </h1>
  </header>
  <aside class="md-master spaced">
    <% if policy(Library).create? %>
      <div class="pt-card">
        <h2 class="admin__title"><%= t '.create_a_new_library' %></h2>
        <%= render 'form' %>
      </div>
    <% end %>
    <div class="pt-dark">
      <div class="pt-callout pt-icon-git-push">
        <%= t '.libraries_on_gala' %>
      </div>
    </div>
  </aside>
  <main class="md-detail pt-dark">
    <table class="admin__table pt-html-table libraries__table">
      <thead>
        <th scope="col"><!-- Logo --></th>
        <th scope="col"><%= t 'activerecord.attributes.library.name' %></th>
        <th scope="col"><!-- Url --></th>
        <th scope="col"><%= t 'activerecord.attributes.library.description' %></th>
        <th scope="col"><!-- Number of Cases --></th>
        <th scope="col"><!-- Edit link --></th>
        <th scope="col"><!-- Delete link --></th>
      </thead>
      <tbody>
        <% libraries.each do |library| %>
          <tr>
            <td class="library-logo" style="<%= library.define_color_variables %>">
              <img src="<%= library.logo_url %>" alt="">
            </td>
            <td>
              <%= library.name %>
              <% if policy(Library).create? && library.visible_in_catalog? %>
                <span class="pt-tag pt-minimal pt-intent-success">
                  <%= t '.on_home_page' %>
                </span>
              <% end %>
            </td>
            <td>
              <% unless library.url.blank? %>
                <%= link_to library.url, class: %i[pt-button pt-minimal pt-icon-share], aria: { label: I18n.t('activerecord.attributes.library.website') }, target: 'blank' do %>
                <% end %>
              <% end %>
            </td>
            <td class="library-description">
              <%= truncate library.description, length: 140, separator: ' ' do %>
                &emsp;
                <%= link_to t('helpers.less.read_more'), library.catalog_path %>
              <% end %>
            </td>
            <td>
              <%= link_to pluralize(library.cases_count, 'case'), library.catalog_path, class: %i[pt-button pt-icon-book library-button] %>
            </td>
            <td>
              <% if policy(library).update? %>
                <%= link_to edit_library_path(library), class: %i[pt-button pt-minimal pt-icon-cog], aria: { label: I18n.t('helpers.edit') } do %>
                <% end %>
              <% end %>
            </td>
            <td>
              <% if policy(library).destroy? %>
                <%= button_to library_path(library), method: :delete, data: { confirm: I18n.t('libraries.destroy.are_you_sure') }, class: %i[pt-button pt-minimal pt-intent-danger pt-icon-trash], aria: { label: I18n.t('libraries.destroy.delete_library') } do %>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </main>
</div>
