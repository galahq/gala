<div class="spaced">
  <%= form_for library, builder: BlueprintFormBuilder do |f| %>
    <%= f.errors %>
    <%= f.form_group :name %>
    <%= f.form_group :description do |f, error_classes| %>
      <%= f.text_area :description, class: %i[pt-input pt-fill] + error_classes %>
    <% end %>
    <%= f.form_group :url %>
    <div class="row">
      <%= f.form_group :background_color do |f, error_classes| %>
        <%= f.color_field :background_color, class: %i[pt-input pt-fill] + error_classes %>
      <% end %>
      <%= f.form_group :foreground_color do |f, error_classes| %>
        <%= f.color_field :foreground_color, class: %i[pt-input pt-fill] + error_classes %>
      <% end %>
    </div>
    <% logo_helper_text = safe_join([
      t('helpers.attachments.max_size.ruby', size: number_to_human_size(2.megabytes)),
      t('helpers.attachments.file_type.ruby', types: %w[PNG].to_sentence)
    ], tag.br) %>
    <%= f.form_group :logo, helper_text: logo_helper_text do |f, error_classes| %>
      <% if f.object.logo.attached? %>
        <%= image_tag ImageDecorator.decorate(f.object.logo).resized_path(width: 50, height: 50), class: 'logo' %>
      <% end %>
      <%= f.file_field :logo, class: %i[pt-fill] + error_classes, direct_upload: true, accept: 'image/png' %>
    <% end %>
    <% if policy(Library).create? %>
      <%= f.check_box :visible_in_catalog %>
    <% end %>
    <%= f.submit %>
  <% end %>
</div>
