<%# Administrate's own show page, plus the closure marker (W9) and the restore
    button (W10) for a closed account.

    This used to be a copy of the application show template. Administrate
    1.0.0 dropped `valid_action?`/`show_action?` and changed `page.attributes`
    to yield attribute groups, which broke the copy, so the extra markup now
    goes through the template's own `before_main` slot and the attribute list
    stays administrate's to maintain. %>
<% reader = page.resource %>
<% deletion_request = reader.pending_account_deletion_request %>

<% if reader.closed? %>
  <% content_for :before_main do %>
    <section class="main-content__body admin-closed-reader">
      <p>
        <strong>
          <% if deletion_request %>
            <%= t "admin.readers.show.closed", date: l(deletion_request.scheduled_for.to_date, format: :long) %>
          <% else %>
            <%= t "admin.readers.show.anonymized" %>
          <% end %>
        </strong>
      </p>
      <% if deletion_request %>
        <p><%= t "admin.readers.show.read_only" %></p>
        <%= button_to t("admin.readers.show.restore"), [:restore, namespace, reader],
                      method: :post, class: "button" %>
      <% end %>
    </section>
  <% end %>
<% end %>

<%# `page` is a local administrate's controller passes to the template, and
    locals do not carry across `render template:`, so pass it through. %>
<%= render template: "administrate/application/show", locals: { page: page } %>
