<%# Replies by others that name the person, in threads they took part in
    (Readers::ErasureMentions). The erasure leaves these alone; the admin
    looks them over before erasing, because afterwards the threads can't be
    found from the person. "Remove name" takes their name out of one reply
    (Readers::RemoveNameFromReply, register O8). Each reply is shown in the
    language(s) that named them, in full, with the name highlighted. %>
<h2><%= t "admin.readers.erasure.mentions.title" %></h2>

<% if mentions.scrubbed? %>
  <p><%= t "admin.readers.erasure.mentions.unsearchable" %></p>
<% elsif !mentions.searchable? %>
  <p><%= t "admin.readers.erasure.mentions.too_short" %></p>
<% elsif mentions.comments.empty? %>
  <p><%= t "admin.readers.erasure.mentions.none", count: mentions.threads_checked %></p>
<% else %>
  <p><%= t "admin.readers.erasure.mentions.found", count: mentions.comments.size, threads: mentions.threads_checked %></p>
  <% if mentions.more? %>
    <p><%= t "admin.readers.erasure.mentions.limited", shown: Readers::ErasureMentions::LIMIT %></p>
  <% end %>
  <table>
    <thead>
      <tr>
        <th><%= t "admin.readers.erasure.mentions.where" %></th>
        <th><%= t "admin.readers.erasure.mentions.by" %></th>
        <th><%= t "admin.readers.erasure.mentions.reply" %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% mentions.comments.each do |comment| %>
        <% thread = comment.comment_thread %>
        <tr>
          <td>
            <%= link_to thread.case&.title || t("admin.readers.erasure.mentions.untitled"),
                        [namespace, thread] %>
            <% if thread.community %><br><small><%= thread.community.name %></small><% end %>
          </td>
          <td><%= comment.reader&.name || Reader.deleted_name %></td>
          <td>
            <% (mentions.matching_texts(comment).presence || [comment.content.to_s]).each do |text| %>
              <p><%= highlight text, mentions.ruby_pattern %></p>
            <% end %>
          </td>
          <td>
            <%= button_to t("admin.readers.erasure.mentions.remove"), [:remove_name, namespace, reader],
                          method: :post, params: { comment_id: comment.id }, class: "button",
                          data: { turbo_confirm: t("admin.readers.erasure.mentions.remove_confirm").squish } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
