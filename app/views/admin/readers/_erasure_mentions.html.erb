<%# Replies by others that name the person, in threads they took part in
    (Readers::ErasureMentions). The erasure leaves these alone; the admin
    looks them over before erasing, because afterwards the threads can't be
    found from the person. %>
<h2><%= t "admin.readers.erasure.mentions.title" %></h2>

<% if !mentions.searchable? %>
  <p><%= t "admin.readers.erasure.mentions.unsearchable" %></p>
<% elsif mentions.total.zero? %>
  <p><%= t "admin.readers.erasure.mentions.none", count: mentions.threads_checked %></p>
<% else %>
  <p><%= t "admin.readers.erasure.mentions.found", count: mentions.total, threads: mentions.threads_checked %></p>
  <% if mentions.total > mentions.comments.size %>
    <p><%= t "admin.readers.erasure.mentions.limited", shown: mentions.comments.size %></p>
  <% end %>
  <table>
    <thead>
      <tr>
        <th><%= t "admin.readers.erasure.mentions.where" %></th>
        <th><%= t "admin.readers.erasure.mentions.by" %></th>
        <th><%= t "admin.readers.erasure.mentions.reply" %></th>
      </tr>
    </thead>
    <tbody>
      <% mentions.comments.each do |comment| %>
        <% thread = comment.comment_thread %>
        <tr>
          <td>
            <%= link_to thread.case&.title || t("admin.readers.erasure.mentions.untitled"),
                        [namespace, thread] %>
            <% if thread.community %><br><small><%= thread.community.name %></small><% end %>
          </td>
          <td><%= comment.reader&.name || Reader.deleted_name %></td>
          <td><%= truncate comment.content.to_s, length: 300 %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
