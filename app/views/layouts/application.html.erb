<!DOCTYPE html>
<html lang="<%= I18n.locale %>" prefix="og: http://ogp.me/ns#">
  <head>
    <meta charset="utf-8">

    <title>
      <% if content_for? :title %><%= content_for :title %> — <% end %>
      Gala
    </title>

    <%= favicon_link_tag 'favicon_gala.png' %>
    <%= csrf_meta_tags %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0"/>
    <% release_version = ENV.fetch('RELEASE', 'development') %>
    <% release_url_base = ENV.fetch('GITHUB_REPOSITORY', 'galahq/gala') %>
    <% release_url = ENV['RELEASE_URL'].presence || (release_version.start_with?('preview.') || release_version.start_with?('production.') ? "https://github.com/#{release_url_base}/releases/tag/#{ERB::Util.url_encode(release_version)}" : "https://github.com/#{release_url_base}/releases/latest") %>
    <meta name="gala-release" content="<%= release_version %>"/>
    <link rel="release" href="<%= release_url %>"/>
    <% mapbox_token = ENV['MapboxAccessToken'] || ENV['MAPBOX_ACCESS_TOKEN'] %>
    <% if mapbox_token.present? %>
      <meta name="mapbox-access-token" content="<%= mapbox_token %>"/>
    <% end %>

    <%= render 'application/reader_javascript_tag' %>
    <%= javascript_tag do %>
      window.i18n = { locale: '<%=I18n.locale%>' }
      window.MAPBOX_ACCESS_TOKEN = '<%= ENV.fetch("MAPBOX_ACCESS_TOKEN", "MAPBOX_TOKEN_REMOVED") %>'
      window.MAPBOX_STYLE = '<%= ENV.fetch("MAPBOX_STYLE", "mapbox://styles/cbothner/cj5l9s2dg2aps2sqfrnidiq14") %>'
    <% end %>

    <script src="https://cdnjs.cloudflare.com/polyfill/v3/polyfill.min.js?features=default,fetch,Intl,Intl.~locale.<%= I18n.locale %>&flags=gated"></script>
    <% if Rails.env.production? || Rails.env.staging? %>
      <script src="https://browser.sentry-cdn.com/4.2.2/bundle.min.js" crossorigin="anonymous"></script>
    <% end %>
    <%= collected_javascript_pack_tag 'styles', 'controllers', 'onboarding' %>
    <%# Blueprint 6 core (application.css) must load BEFORE the pack CSS, whose
        blueprint-theme overrides re-apply Gala's brand colors by cascade order.
        In production the pack CSS is an extracted <link>; if it loads first, BP6's
        stock-blue core wins and the purple is lost. (Dev works either way because
        style-loader injects the pack CSS last.) %>
    <%= stylesheet_link_tag 'application', media: 'all' %>
    <%= collected_stylesheet_pack_tag 'styles' %>
    <%= render 'application/fonts' %>

    <%= javascript_include_tag 'application' %>

    <meta property="og:site_name" content="Gala" />
    <% if content_for? :head %><%= content_for :head %><% end %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
