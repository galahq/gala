<!DOCTYPE html>
<html lang="<%= I18n.locale %>" prefix="og: http://ogp.me/ns#">
  <head>
    <meta charset="utf-8">

    <title>
      <% if content_for? :title %><%= content_for :title %> — <% end %>
      Gala
    </title>

    <%= favicon_link_tag 'favicon_gala.png' %>
    <%= csrf_meta_tags if reader_signed_in? ||
                           controller_name != 'catalog' ||
                           action_name != 'home' %>
    <%= action_cable_meta_tag %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0"/>
    <% release_version = gala_release_label %>
    <% release_url = gala_release_url %>
    <meta name="gala-release" content="<%= release_version %>"/>
    <link rel="release" href="<%= release_url %>"/>
    <% mapbox_token = ENV['MapboxAccessToken'] || ENV['MAPBOX_ACCESS_TOKEN'] %>
    <% if mapbox_token.present? %>
      <meta name="mapbox-access-token" content="<%= mapbox_token %>"/>
    <% end %>

    <%= render 'application/reader_javascript_tag' %>
    <%= javascript_tag do %>
      window.i18n = { locale: '<%=I18n.locale%>' }
      window.MAPBOX_ACCESS_TOKEN = '<%= ENV.fetch("MAPBOX_ACCESS_TOKEN", "MAPBOX_TOKEN_REMOVED") %>'
      window.MAPBOX_STYLE = '<%= ENV.fetch("MAPBOX_STYLE", "mapbox://styles/cbothner/cj5l9s2dg2aps2sqfrnidiq14") %>'
    <% end %>
    <% posthog_api_key = ENV["POSTHOG_API_KEY"] %>
    <% posthog_enabled = posthog_api_key.present? && ENV.fetch("POSTHOG_ENABLED", "true").to_s == "true" %>
    <% posthog_stage = ENV["SST_STAGE"].presence || Rails.env %>
    <% posthog_event_namespace = "#{posthog_stage}->> " %>
    <% posthog_config = {
         enabled: posthog_enabled,
         apiKey: posthog_api_key || "",
         apiHost: ENV.fetch("POSTHOG_HOST", "https://us.i.posthog.com"),
         projectId: ENV.fetch("POSTHOG_PROJECT_ID", ""),
         stage: posthog_stage,
         eventNamespace: posthog_event_namespace
       } %>
    <%= javascript_tag do %>
      window.POSTHOG_CONFIG = <%= raw json_escape(posthog_config.to_json) %>
    <% end %>

    <script src="https://cdnjs.cloudflare.com/polyfill/v3/polyfill.min.js?features=default,fetch,Intl,Intl.~locale.<%= I18n.locale %>&flags=gated"></script>
    <%= collected_javascript_bundle_tags 'application' %>
    <%= collected_stylesheet_bundle_tags 'application', media: 'all' %>
    <%= safe_stylesheet_bundle_tag 'application', media: 'all' %>
    <%= render 'application/fonts' %>

    <meta property="og:site_name" content="Gala" />
    <% if content_for? :head %><%= content_for :head %><% end %>
  </head>

  <body data-rails-controller="<%= controller_path %>" data-rails-action="<%= action_name %>" data-rails-layout="<%= content_for?(:rails_layout) ? content_for(:rails_layout) : 'application' %>">
    <%= yield %>
  </body>
</html>
