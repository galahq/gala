<header class="header">
  <div class="header__container" style="justify-content: center">
    <%= link_to root_path, id: "gala-logo" do %>
      <%= inline_svg 'gala-logo.svg' %>
    <% end %>
  </div>
</header>

<div class="window window-embed" style="min-height: calc(100% - 73px)">
  <%= yield %>
</div>

<%# This layout renders no footer, so without this an embedded reader who
    declined would have no way back to the question — the one place the
    withdrawal link in application/_footer cannot reach. %>
<% if show_consent_withdrawal? %>
  <p class="consent-embed-withdrawal">
    <%= link_to t('application.footer.cookies'), '#',
                data: { controller: 'consent', action: 'consent#reopen' } %>
  </p>
<% end %>

<% parent_layout 'application' %>
