<div class="pt-card pt-elevation-4 devise-card terms-of-service pt-form-group">
  <h2 class="account-settings__title"><%= t '.terms_of_service_title' %></h2>
  <div class="pt-card terms-text-area">
    <!-- Unknown filter: markdown -->
    #{render file: "config/locales/terms_of_service/terms_of_service_en.md"}

  </div>
  <div>
    <%= form_for @reader, url: update_tos_reader_url(@reader), method: :post, builder: BlueprintFormBuilder do |f| %>
      <%= f.check_box :terms_of_service %>
      <%= f.submit t('.accept_tos'), class: %w[pt-intent-primary] %>
    <% end %>
  </div>
</div>
