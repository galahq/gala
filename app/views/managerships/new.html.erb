<% content_for :title do %>
  <%= I18n.t('managerships.new.invite_someone_to_manage_this_library') %>
  —
  <%= library.name %>
<% end %>
<div class="window admin">
  <div class="admin-card pt-card pt-elevation-2">
    <%= link_to edit_library_url library do %>
      <div class="library-cover-card-top" style="<%= library.define_color_variables %>">
        <span class="admin__table__slug"><%= library.name %></span>
      </div>
    <% end %>
    <div>
      <h1 class="admin__title"><%= t '.invite_someone_to_manage_this_library' %></h1>
      <%= form_for @managership, url: library_managerships_path(library), builder: BlueprintFormBuilder do |f| %>
        <%= f.errors %>
        <p><%= t('.instructions') %></p>
        <%= f.form_group :manager_email do |f, error_classes| %>
          <div class="pt-input-group pt-fill <%= error_classes %>">
            <span class="pt-icon pt-icon-envelope"></span>
            <%= f.email_field :manager_email, class: %w[pt-input] %>
          </div>
        <% end %>
        <%= f.submit I18n.t('managerships.new.add_manager'), class: %w[pt-button pt-intent-success] %>
      <% end %>
    </div>
  </div>
</div>
