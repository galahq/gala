<%# frozen_string_literal: true %>

<% if field.data %>
  <% associated_label =
       begin
         field.display_associated_resource
       rescue StandardError
         field.data.try(:name) || field.data.try(:title) || field.data.try(:id) || field.data.to_s
       end %>

  <% if accessible_action?(field.data, :show) %>
    <%= link_to(associated_label, [namespace, field.data]) %>
  <% else %>
    <%= associated_label %>
  <% end %>
<% end %>
