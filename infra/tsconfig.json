{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": [".sst/platform/node_modules/@types"]
  },
  "include": ["*.ts", "stages/**/*.ts", "test/**/*.ts"],
  "exclude": [".sst"]
}
