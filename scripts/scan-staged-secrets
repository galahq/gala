#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"

repo_root, root_status = Open3.capture2("git", "rev-parse", "--show-toplevel")
unless root_status.success?
  warn "Unable to find git repository root for staged secret scan."
  exit 2
end

Dir.chdir(repo_root.strip)

paths_raw, paths_status = Open3.capture2(
  "git",
  "diff",
  "--cached",
  "--name-only",
  "--diff-filter=ACMR",
  "-z"
)

unless paths_status.success?
  warn "Unable to list staged files for secret scan."
  exit 2
end

paths = paths_raw.split("\0").reject(&:empty?)
exit 0 if paths.empty?

TOKEN_RULES = [
  {
    name: "Cloudflare API token",
    regex: /\bcfat_[A-Za-z0-9_-]{20,}\b/
  },
  {
    name: "GitHub token",
    regex: /\bgh[pousr]_[A-Za-z0-9_]{30,}\b/
  },
  {
    name: "Mapbox access token",
    regex: /\b(?:pk|sk)\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b/
  },
  {
    name: "AWS access key id",
    regex: /\b(?:AKIA|ASIA)[A-Z0-9]{16}\b/
  },
  {
    name: "private key block",
    regex: /-----BEGIN (?:RSA |EC |OPENSSH |DSA |)?PRIVATE KEY-----/
  }
].freeze

SECRET_ASSIGNMENT = /
  \b(?<key>[A-Z0-9_]*(?:TOKEN|SECRET|PASSWORD|PRIVATE_KEY|ACCESS_KEY)[A-Z0-9_]*)\b
  \s*[:=]\s*
  ["']?
  (?<value>
    (?!\$|\{\{|\<%|<|placeholder\b|secret\b|null\b|nil\b|false\b|true\b)
    [A-Za-z0-9+\/_.:=@%,-]{20,}
  )
  ["']?
/ix

PLACEHOLDER_WORDS = %w[
  changeme
  change_me
  dummy
  example
  fake
  placeholder
  please_replace
  redacted
  replace_me
  sample
  test
  your_
  your-
].freeze

def text_content?(content)
  !content.include?("\x00")
end

def placeholder_value?(value)
  normalized = value.downcase
  PLACEHOLDER_WORDS.any? { |word| normalized.include?(word) }
end

def generated_value_reference?(value)
  normalized = value.delete_suffix(",").delete_suffix(";")
  return true if normalized.match?(/\A[a-z_][a-z0-9_]*(?:[!?])?\z/)

  normalized.match?(/\A(?:window|process\.env)\.[A-Za-z0-9_.]+\z/)
end

def each_match(line, regex)
  offset = 0
  while (match = regex.match(line, offset))
    yield match
    next_offset = match.end(0)
    offset = next_offset > offset ? next_offset : offset + 1
  end
end

violations = []

paths.each do |path|
  content, content_status = Open3.capture2("git", "show", ":#{path}")
  next unless content_status.success?

  content = content.b
  next unless text_content?(content)

  text = content.encode("UTF-8", invalid: :replace, undef: :replace)
  text.each_line.with_index(1) do |line, line_number|
    TOKEN_RULES.each do |rule|
      each_match(line, rule[:regex]) do
        violations << {
          path: path,
          line: line_number,
          rule: rule[:name]
        }
      end
    end

    each_match(line, SECRET_ASSIGNMENT) do |match|
      next if match[:key].downcase.end_with?("_field")

      value = match[:value]
      next if placeholder_value?(value)
      next if generated_value_reference?(value)

      violations << {
        path: path,
        line: line_number,
        rule: "secret-like assignment",
        detail: match[:key]
      }
    end
  end
end

if violations.any?
  warn "Staged secret scan failed. Remove the candidate secret before committing."
  warn "The scanner reports locations only and does not print secret values."
  violations.each do |violation|
    detail = violation[:detail] ? " (#{violation[:detail]})" : ""
    warn "  #{violation[:path]}:#{violation[:line]} #{violation[:rule]}#{detail}"
  end
  exit 1
end

puts "Staged secret scan passed for #{paths.length} file#{paths.length == 1 ? '' : 's'}."
