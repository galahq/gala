# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle
/vendor/bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore Byebug command history file.
.byebug_history

# Ignore vagrant box files
.vagrant

node_modules/

/.pnpm-store
/.playwright-browsers
/spec/playwright-report
/spec/test-results

app/assets/javascripts/react
/node_modules

localhost.crt
localhost.key
/public/packs
/public/packs-test
/public/assets
!public/robots.txt
!public/favicon.ico

/.yardoc/
/doc/

/db_dumps
/db/sqldump/

# Ignore master key for decrypting credentials and more.
/config/master.key

/storage
/infra/.sst/

spec/examples.txt
.OLD
*.*.OLD
.env
.env.dev
.env.google
.env.google_migrated
.env.cloudflare
.env.secrets.migrate
cloudflare.txt
client_secret_*.json
.posthog.creds.txt
dev.learngala.global
.DS_Store
.*OLD
.*.OLD
.*ORIG
.env.dev

# Ignore vscode settings
/.vscode

# openssl generated certs
infra/global-bundle.pem

# spec workflow
/.planning
/.superpowers/
/.work/
/AGENTS.md
/.worktrees/
